<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Rasputin.exe" product-name="Rasputin" product-version="${version}" original-filename="Rasputin.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="rasputin-backend.exe" product-name="Rasputin" product-version="${version}" original-filename="rasputin-backend.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
